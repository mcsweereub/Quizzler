<!-- App colours for the dark theme. Keep keys in sync with Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#262626" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="ChipTextBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#A5B4FC" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#5B5BD6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#25243F" />

    <SolidColorBrush x:Key="CorrectBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="CorrectSoftBrush" Color="#15291C" />
    <SolidColorBrush x:Key="WrongBrush" Color="#F87171" />
    <SolidColorBrush x:Key="WrongSoftBrush" Color="#331C1C" />

    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#161616" />
    <SolidColorBrush x:Key="CodeForegroundBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="CodeInlineBackground" Color="#33363D" />
</ResourceDictionary>
