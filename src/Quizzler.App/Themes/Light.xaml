<!-- App colours for the light theme. Every key here must also exist in Dark.xaml.
     Reference these with DynamicResource so they switch live when the theme changes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ChipTextBrush" Color="#374151" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />

    <!-- Accent for text/borders, and a separate fill for buttons with white text. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FF" />

    <SolidColorBrush x:Key="CorrectBrush" Color="#15803D" />
    <SolidColorBrush x:Key="CorrectSoftBrush" Color="#F0FDF4" />
    <SolidColorBrush x:Key="WrongBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="WrongSoftBrush" Color="#FEF2F2" />

    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="CodeForegroundBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="CodeInlineBackground" Color="#EEF2F7" />
</ResourceDictionary>
